---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { companies } from '../data/companies';

const roles = [...new Set(companies.flatMap((company) => company.roles))];
const skills = [...new Set(companies.flatMap((company) => company.skills))];
---
<BaseLayout>
  <main id="main">
    <section class="hero page-wrap" aria-labelledby="hero-title">
      <div class="hero__copy" data-reveal>
        <p class="eyebrow"><span class="live-signal" aria-hidden="true"></span> Hyderabad · student field guide <span class="eyebrow-index">NO. 01</span></p>
        <h1 id="hero-title">Your next move<br />starts <em>here.</em></h1>
        <p class="hero__summary">A clearer view of Hyderabad’s tech scene—company notes, official career links, and student research prompts, all in one place.</p>
        <div class="hero__actions">
          <a class="button button--lime" href="#companies">Explore the directory <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="/standards">How we verify <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero__caution"><span aria-hidden="true">✳</span> No made-up vacancies. Every profile separates verified facts from unverified prep notes.</p>
      </div>
      <div class="hero-art" aria-label="Abstract map of career pathways converging in Hyderabad" role="img" data-reveal>
        <div class="hero-art__wash"></div>
        <svg class="hero-art__routes" viewBox="0 0 600 500" fill="none" aria-hidden="true">
          <path d="M38 407C118 374 130 309 193 294c71-17 62-102 143-128 49-16 94-3 212-100" stroke="rgba(199,255,113,.53)" stroke-width="2" stroke-dasharray="5 9" />
          <path d="M56 104c86 54 105 112 184 129 86 19 112 119 199 106 49-8 72-40 127-19" stroke="rgba(255,130,104,.54)" stroke-width="2" stroke-dasharray="3 11" />
          <path d="M64 471c58-87 102-144 169-162 95-27 127 35 179 6 57-31 38-118 106-187" stroke="rgba(186,164,255,.5)" stroke-width="2" stroke-dasharray="2 10" />
          <circle cx="194" cy="294" r="8" fill="#C7FF71"/><circle cx="336" cy="166" r="7" fill="#FF8268"/><circle cx="439" cy="339" r="6" fill="#BAA4FF"/>
          <circle cx="194" cy="294" r="20" stroke="rgba(199,255,113,.38)"/><circle cx="336" cy="166" r="19" stroke="rgba(255,130,104,.35)"/><circle cx="439" cy="339" r="18" stroke="rgba(186,164,255,.35)"/>
        </svg>
        <div class="hero-art__orbit hero-art__orbit--one"></div>
        <div class="hero-art__orbit hero-art__orbit--two"></div>
        <div class="hero-art__core"><span>HYD</span><small>17.3850° N<br />78.4867° E</small></div>
        <div class="hero-art__label hero-art__label--one"><span class="label-dot label-dot--lime"></span>Official sources</div>
        <div class="hero-art__label hero-art__label--two"><span class="label-dot label-dot--violet"></span>Student notes</div>
        <div class="hero-art__index">FIELD MAP <span>01—03</span></div>
      </div>
    </section>

    <div class="signal-strip" aria-label="Guide features">
      <div><span class="signal-strip__number">03</span><span>starter company profiles</span></div>
      <div><span class="signal-strip__number">01</span><span>official link per profile</span></div>
      <div><span class="signal-strip__number">0</span><span>unverified vacancy claims</span></div>
      <p>Independent student guide <span aria-hidden="true">↗</span></p>
    </div>

    <section class="directory page-wrap" id="companies" aria-labelledby="directory-title">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow"><span class="eyebrow-index">01 / THE INDEX</span> START WITH A COMPANY</p>
          <h2 id="directory-title">A city of <em>possibilities.</em></h2>
        </div>
        <p class="section-heading__note">Browse official company links. Use the tags to explore student-prep topics—not as a promise of an open role.</p>
      </div>

      <div class="directory-tools" data-reveal>
        <label class="search-box">
          <span class="sr-only">Search companies, roles, and skills</span>
          <span class="search-box__icon" aria-hidden="true">⌕</span>
          <input id="company-search" type="search" placeholder="Search companies, roles, skills…" autocomplete="off" />
          <span class="search-box__shortcut" aria-hidden="true">↵</span>
        </label>
        <label class="select-box">
          <span class="sr-only">Filter by role topic</span>
          <select id="role-filter">
            <option value="all">All role topics</option>
            {roles.map((role) => <option value={role.toLowerCase()}>{role}</option>)}
          </select>
          <span aria-hidden="true">⌄</span>
        </label>
      </div>
      <div class="skill-filters" aria-label="Filter by research skill topic">
        <span class="filter-label">Explore skills</span>
        <button class="filter-chip is-active" type="button" data-skill-filter="all" aria-pressed="true">All</button>
        {skills.map((skill) => <button class="filter-chip" type="button" data-skill-filter={skill.toLowerCase()} aria-pressed="false">{skill}</button>)}
      </div>
      <div class="results-meta"><p id="result-count" role="status" aria-live="polite">Showing {companies.length} starter profiles</p><p>Role and skill tags are unverified prep prompts</p></div>

      <ul class="company-grid" id="company-grid">
        {companies.map((company, index) => <CompanyCard company={company} index={index} />)}
      </ul>
      <div class="empty-state" id="empty-state" hidden>
        <span class="empty-state__symbol" aria-hidden="true">↗</span>
        <h3>No profiles match that search.</h3>
        <p>Try another company name or clear a filter.</p>
        <button class="text-link" id="reset-filters" type="button">Reset filters <span aria-hidden="true">↻</span></button>
      </div>
    </section>

    <section class="closing-note page-wrap" data-reveal>
      <div class="closing-note__mark" aria-hidden="true">↗</div>
      <div><p class="eyebrow">A NOTE ON THE NOTES</p><h2>Good research starts<br />with <em>good sources.</em></h2></div>
      <p>Company pages and student programs change. We link you straight to the source, and mark every unverified prep prompt so you know what still needs checking.</p>
      <a class="button button--outline" href="/standards">Our sourcing rules <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#company-search');
  const roleSelect = document.querySelector<HTMLSelectElement>('#role-filter');
  const skillButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-skill-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-company-card]')];
  const resultCount = document.querySelector<HTMLElement>('#result-count');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  const grid = document.querySelector<HTMLElement>('#company-grid');
  const resetButton = document.querySelector<HTMLButtonElement>('#reset-filters');
  let activeSkill = 'all';

  const filterCards = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    const role = roleSelect?.value ?? 'all';
    let visible = 0;
    for (const card of cards) {
      const matchesQuery = (card.dataset.search ?? '').includes(query);
      const roles = (card.dataset.roles ?? '').split('|');
      const skills = (card.dataset.skills ?? '').split('|');
      const matchesRole = role === 'all' || roles.includes(role);
      const matchesSkill = activeSkill === 'all' || skills.includes(activeSkill);
      const show = matchesQuery && matchesRole && matchesSkill;
      card.hidden = !show;
      if (show) visible++;
    }
    if (resultCount) resultCount.textContent = `Showing ${visible} ${visible === 1 ? 'starter profile' : 'starter profiles'}`;
    if (emptyState) emptyState.hidden = visible !== 0;
    if (grid) grid.hidden = visible === 0;
  };

  searchInput?.addEventListener('input', filterCards);
  roleSelect?.addEventListener('change', filterCards);
  skillButtons.forEach((button) => button.addEventListener('click', () => {
    activeSkill = button.dataset.skillFilter ?? 'all';
    skillButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    filterCards();
  }));
  resetButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (roleSelect) roleSelect.value = 'all';
    activeSkill = 'all';
    skillButtons.forEach((button) => {
      const active = button.dataset.skillFilter === 'all';
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    filterCards();
    searchInput?.focus();
  });

  document.documentElement.classList.add('has-js');
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>

---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
}

const {
  title = 'Hyderabad Tech Guide | Student Company Field Notes',
  description = 'A source-linked field guide to technology companies in Hyderabad, built for engineering students exploring future opportunities.',
  eyebrow = 'Hyderabad Tech Guide',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1820" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Hyderabad tech companies, student careers, engineering placements, Hyderabad internships, fresher roles" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hyderabad Tech Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
